{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=MechanicShopDb;Username=admin;Password=YourStrong@Password1"
  },
  "AppSettings": {
    "OpeningTime": "00:00",
    "ClosingTime": "23:59:59",
    "MaxSpots": 4,
    "MinimumAppointmentDurationInMinutes": 30,
    "LocalCacheExpirationInMins": 5,
    "DistributedCacheExpirationMins": 5,
    "DefaultPageNumber": 1,
    "DefaultPageSize": 10,
    "BookingCancellationThresholdMinutes": 15,
    "OverdueBookingCleanupFrequencyMinutes": 3,
    "Cors": {
      "PolicyName": "MechanicShop",
      "AllowedOrigins": [ "http://localhost:4200", "https://localhost:5001", "http://mechanicshop-app" ]
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "https://logs-prod-012.grafana.net",
          "credentials": {
            "login": "FROM_ENV",
            "password": "FROM_ENV"
          },
          "labels": [
            { "key": "app", "value": "MechanicShop.Api" },
            { "key": "env", "value": "production" }
          ],
          "period": "00:00:01",
          "eagerlyEmitFirstEvent": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "api"
    }
  },
  "JwtSettings": {
    "Secret": "96461dde37850c762273043f6927cb14fa9dc424fb35ceae63e494da6cce27ff",
    "ExpiryMinutes": 60,
    "Issuer": "localhost",
    "Audiences": [ "localhost" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}